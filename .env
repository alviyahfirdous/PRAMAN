# ─── Database ─────────────────────────────────────────────
POSTGRES_DB=praman
POSTGRES_USER=praman_user
POSTGRES_PASSWORD=praman_secret

# ─── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://praman_user:praman_secret@localhost:5432/praman
DATABASE_URL_SYNC=postgresql://praman_user:praman_secret@localhost:5432/praman
REDIS_URL=redis://localhost:6379/0

# IMPORTANT: Change this to a random 64-char string in production
SECRET_KEY=dev-secret-key-change-in-production-please-use-random-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
